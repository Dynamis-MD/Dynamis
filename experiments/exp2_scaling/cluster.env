# shellcheck shell=bash
# ---------------------------------------------------------------------------
# Cluster configuration for exp2_scaling (model-agnostic scaling benchmarks).
# Defaults target Empire AI "beta" (GB200 / Grace-Blackwell, aarch64, 4x B200/node).
#
# To override locally without touching tracked files, create:
#   experiments/exp2_scaling/cluster.local.env
# ---------------------------------------------------------------------------

_exp2_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$_exp2_env_dir/cluster.local.env" ] && . "$_exp2_env_dir/cluster.local.env"

# ---- Slurm scheduler (Empire AI GB200 beta) -------------------------------
: "${EXP2_ACCOUNT:=su_kchiu_molecular}"
: "${EXP2_PARTITION:=beta}"
: "${EXP2_TEST_PARTITION:=beta_test}"
: "${EXP2_QOS:=priority}"
: "${EXP2_TEST_QOS:=test}"
: "${EXP2_GPUS_PER_NODE:=4}"          # Must allocate all 4 B200 GPUs per node
: "${EXP2_CPUS_PER_TASK:=32}"
: "${EXP2_MEM:=0}"                    # 0 = whole-node RAM (~1.5 TB)
: "${EXP2_SBATCH_EXTRA:=}"

# ---- Software environment & CUDA -----------------------------------------
: "${EXP2_CUDA_HOME:=$HOME/cuda/13.0.3}"
: "${EXP2_TORCH_VERSION:=2.13.0}"
: "${EXP2_TORCH_INDEX:=https://download.pytorch.org/whl/cu130}"
: "${EXP2_TORCH_CUDA_ARCH_LIST:=8.0 9.0 10.0}"
: "${EXP2_PYTHON:=3.12}"
: "${EXP2_UV:=uv}"

# ---- Runtime / NCCL / MNNVL ----------------------------------------------
# Multi-node control plane on Empire AI beta:
#   - bond0 is the routable management network for OOB bootstrap (IPoIB has no
#     inter-node route on beta).
#   - NCCL_IB_HCA pins the 4x 400G IB HCAs (avoids IB vs RoCE mismatch).
#   - NCCL_MNNVL_ENABLE=0 keeps NCCL collectives stable on IB regardless of
#     per-node IMEX state; GPUDirectExchanger uses CUDA Fabric handles directly.
: "${EXP2_NCCL_SOCKET_IFNAME:=bond0}"
: "${EXP2_GLOO_SOCKET_IFNAME:=bond0}"
: "${EXP2_NCCL_IB_HCA:=mlx5_0,mlx5_1,mlx5_4,mlx5_5}"
: "${EXP2_NCCL_MNNVL_ENABLE:=0}"
: "${EXP2_OMP_NUM_THREADS:=8}"
: "${EXP2_NCCL_DEBUG:=WARN}"
