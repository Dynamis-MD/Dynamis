# shellcheck shell=bash
# ---------------------------------------------------------------------------
# Cluster-specific configuration for the exp0 end-to-end MD benchmark.
#
# Every script under scripts/ sources this file (via _lib.sh). The defaults
# below target NCSA Delta (partition gpuA100x4). To run on a DIFFERENT cluster
# you do NOT edit this file -- instead either:
#
#   (a) copy scripts/cluster.env.example -> scripts/cluster.local.env and edit
#       it (git-ignored, sourced first and wins), or
#   (b) export the EXP0_* variables in your shell / job environment before
#       calling the scripts.
#
# Only the values that actually differ need to be set; anything left unset
# falls back to the Delta default here.
# ---------------------------------------------------------------------------

# Site overrides: a local file, if present, is applied before the defaults.
_exp0_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$_exp0_env_dir/cluster.local.env" ] && . "$_exp0_env_dir/cluster.local.env"

# ---- Scheduler (Slurm) ----------------------------------------------------
# Accounts / partitions for GPU jobs (matrix, smoke) and the CPU-only
# environment build.
: "${EXP0_GPU_ACCOUNT:=bcpt-delta-gpu}"
: "${EXP0_CPU_ACCOUNT:=bcpt-delta-cpu}"
: "${EXP0_GPU_PARTITION:=gpuA100x4}"
: "${EXP0_CPU_PARTITION:=cpu}"
: "${EXP0_CPUS_PER_TASK:=16}"
: "${EXP0_GPU_MEM:=200g}"
: "${EXP0_CPU_MEM:=48g}"
# GPUs per node available on EXP0_GPU_PARTITION -- submit_matrix.sh will not
# request more than this for any cell.
: "${EXP0_GPUS_PER_NODE_MAX:=4}"
# Anything extra every sbatch call should carry, e.g. "--qos=normal --constraint=x".
: "${EXP0_SBATCH_EXTRA:=}"

# ---- Software environment ------------------------------------------------
# EXP0_MODULES: arguments passed verbatim to a single `module load`, in order.
# Set to the empty string on clusters with no Lmod/tcl `module` (conda- or
# container-based) -- the scripts then just skip module handling.
# (bare `=`, not `:=`, so an explicit `EXP0_MODULES=""` from cluster.local.env
# is honoured instead of being re-defaulted here.)
: "${EXP0_MODULES=python/3.13.5-gcc13.3.1 cudatoolkit/26.5_12.9-unsupported gcc-native/14 aws-ofi-nccl}"
# Modules to `module unload` first (Delta auto-loads a default cudatoolkit that
# collides with the cu128 one). Space-separated; empty to skip.
: "${EXP0_MODULE_UNLOAD=cudatoolkit}"
# 1 => run `module purge` before anything else.
: "${EXP0_MODULE_PURGE:=0}"

# ---- Paths --------------------------------------------------------------
# REPO_ROOT and the inner monorepo are derived from each script's own location
# (see _lib.sh); override here only if your checkout layout differs.
: "${EXP0_REPO_ROOT:=}"                 # default: <this file>/../../..
: "${EXP0_VENV:=}"                      # default: <repo>/DistNNP/.venv-uma
: "${EXP0_UV:=uv}"                      # uv binary (env_setup.sh only)

# ---- Runtime / NCCL ----------------------------------------------------
# High-speed fabric interface for NCCL. Delta = "hsn"; set to your cluster's
# (e.g. "ib0", "bond0") or the empty string to let NCCL auto-detect (bare `=`
# so an explicit `EXP0_NCCL_SOCKET_IFNAME=""` override is honoured).
: "${EXP0_NCCL_SOCKET_IFNAME=hsn}"
: "${EXP0_OMP_NUM_THREADS:=8}"
# uma-s-1p2 is pre-cached by env_setup.sh, so jobs run fully offline. Set to 0
# if your compute nodes have internet and you skipped the pre-warm.
: "${EXP0_HF_HUB_OFFLINE:=1}"
# Optional explicit HF / fairchem cache locations (else the user default).
: "${EXP0_HF_HOME:=}"

# ---- Datasets (setup_datasets.sh) --------------------------------------
# Which tiers to build and what to generate. See scripts/setup_datasets.sh.
: "${EXP0_DATA_TIERS:=1 2 3 4}"
: "${EXP0_DATA_CH4_SIZES:=1 2 32 64 128}"
: "${EXP0_DATA_SOLVATED:=9gmo 2rik 1aki}"       # Tier 4 solvated proteins ("" = none)
: "${EXP0_DATA_ELECTROCHEM:=12k 17k}"           # Tier 4 Pt+water ("" = none)
#
# Tier 3 hosted archive source (consumed by exp_datasets/scripts/download_datasets.sh).
# Order tried: LOCAL -> SHARED_DIR cache -> `gh release download` -> wget URL.
# On Delta the shared cache below already holds the archive (no network needed).
# On another cluster, set DISTNNP_ARCHIVE_LOCAL to a staged copy, or point
# DISTNNP_ARCHIVE_SHARED_DIR at a group-readable dir, or leave the gh/URL path
# (needs `gh auth login` while the repo is private). These MUST be exported --
# download_datasets.sh runs as a child process.
export DISTNNP_ARCHIVE_SHARED_DIR="${DISTNNP_ARCHIVE_SHARED_DIR:-/projects/bcpt/public/distnnp_datasets}"
[ -n "${DISTNNP_ARCHIVE_LOCAL:-}" ] && export DISTNNP_ARCHIVE_LOCAL
[ -n "${DISTNNP_ARCHIVE_URL:-}" ]   && export DISTNNP_ARCHIVE_URL
[ -n "${DISTNNP_ARCHIVE_REPO:-}" ]  && export DISTNNP_ARCHIVE_REPO
[ -n "${DISTNNP_ARCHIVE_TAG:-}" ]   && export DISTNNP_ARCHIVE_TAG

# ---- Extension build (env_setup.sh only) --------------------------------
# CUDA architectures to compile the 4 distnnp CUDA extensions for.
#   A100 = 80, H100/H200 = 90, A40 = 86, V100 = 70.
: "${EXP0_CUDA_ARCH:=80;90}"
: "${EXP0_TORCH_VERSION:=2.8.0}"

# ---- LAMMPS + MACE baseline (Workstream B, implementation_plan.md §12) ---
# The LAMMPS-MACE engine needs its OWN python env + a from-source LAMMPS build
# (the stock `lammps/*` modules have ML-IAP / KOKKOS / PYTHON all OFF).
# Lives OUTSIDE $HOME (quota) on the project filesystem. On Delta the Lustre
# scratch client on gpu compute nodes was observed badly degraded (torch's ~2GB
# of .so read at ~1 MB/s), while /projects (Taiga) reads fine -- so the default
# is /projects. exp0_stage_lammps still copies it node-local at job start.
_exp0_proj="${EXP0_LAMMPS_ROOT:-/projects/bcpt/$USER/exp0-lammps}"
[ -d "$(dirname "$_exp0_proj")" ] || _exp0_proj="$HOME/exp0-lammps"
: "${EXP0_LAMMPS_VENV:=${_exp0_proj}/venv-lammps-mace}"
: "${EXP0_LAMMPS_BUILD_DIR:=${_exp0_proj}}"
: "${EXP0_LAMMPS_BIN:=${_exp0_proj}/lammps-install/bin/lmp}"
# Module set for the LAMMPS build AND for run_cell.sbatch's lammps-mace branch.
# Differs from EXP0_MODULES: CUDA-aware MPI + a CUDA toolkit for Kokkos-CUDA.
# NOTE (Delta): `cuda/12.9` conflicts with the auto-loaded `cudatoolkit`; use
# `cudatoolkit/26.5_12.9-unsupported` (nvcc 12.9, CUDA_HOME set). There is no
# cuda/12.6 module -- nvcc 12.9 against a cu126 libtorch is accepted (12.x minor
# forward-compat). nvhpc-hpcx-cuda12-openmpi5 gives CUDA-aware OpenMPI 5; it also
# puts nvhpc's nvc++ on PATH -- build_lammps.sh forces g++ as the Kokkos host
# compiler. EXP0_MODULE_UNLOAD (=cudatoolkit) is honoured first.
: "${EXP0_LAMMPS_MODULES:=cudatoolkit/26.5_12.9-unsupported gcc-native/14 cmake/3.31.8 nvhpc-hpcx-cuda12-openmpi5/26.5 fftw}"
: "${EXP0_LAMMPS_PYTHON:=python3.12}"
# torch wheel for the LAMMPS venv. cu126 matches the known-good mace ML-IAP
# stack (see mace#1294); 2.6.0 is the exact reported stack, 2.7.1 is the
# forward bet. Last-resort fallback is reusing .venv-uma (torch 2.8+cu128).
: "${EXP0_LAMMPS_TORCH:=2.7.1}"
: "${EXP0_LAMMPS_TORCH_INDEX:=https://download.pytorch.org/whl/cu126}"
# MACE foundation model for the baseline. medium-mpa-0 == what the DistNNP-side
# MACE adapter (branch MACE-Adaptation) uses, so the eventual DistNNP-MACE vs
# LAMMPS-MACE comparison is apples-to-apples.
: "${EXP0_MACE_MODEL_NAME:=medium-mpa-0}"
: "${EXP0_MACE_MODEL:=${_exp0_proj}/mace_models/mace-mpa-0-medium.model}"
: "${EXP0_MACE_HEAD:=}"   # set if create_lammps_model prompts for a head
# ML-IAP model precision. MUST be float32: the DistNNP-side MACE adapter
# (branch MACE-Adaptation) only runs FP32, and the exp0 comparison holds the
# model fixed -- both engines must use the same precision. float32 also roughly
# halves the per-rank GPU footprint vs float64 (the cuEq TP kernel's big
# intermediate), which widens the runnable box/GPU envelope substantially.
: "${EXP0_MACE_DTYPE:=float32}"
# Node-local venv staging: OFF by default. A first `import torch,mace` from
# /projects costs ~60 s (Delta's parallel fs are slow for many small files from
# gpu nodes) but the OS page cache makes every later invocation on that node
# fast -- cheaper than copying the ~100k-file venv. Set to 0 to re-enable if a
# job does many independent python starts on a fresh node.
: "${EXP0_LAMMPS_NO_STAGE:=1}"
# dtype-suffixed so a float32 and a float64 conversion can coexist and a stale
# .pt from the other precision is never silently reused.
: "${EXP0_MACE_MLIAP_PT:=${EXP0_MACE_MODEL}-mliap_lammps_${EXP0_MACE_DTYPE}.pt}"
# element -> LAMMPS type order for pair_coeff (must be a subset of the model's
# trained elements). CH4:O2 baselines are {C,H,O}.
: "${EXP0_MACE_ELEMENTS:=C H O}"
