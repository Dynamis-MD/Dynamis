# shellcheck shell=bash
# ---------------------------------------------------------------------------
# Cluster-specific configuration for the exp0 end-to-end MD benchmark.
#
# Every script under scripts/ sources this file (via _lib.sh). The defaults
# below target NCSA Delta (partition gpuA100x4). To run on a DIFFERENT cluster
# you do NOT edit this file -- instead either:
#
#   (a) copy scripts/cluster.env.example -> scripts/cluster.local.env and edit
#       it (git-ignored, sourced first and wins), or
#   (b) export the EXP0_* variables in your shell / job environment before
#       calling the scripts.
#
# Only the values that actually differ need to be set; anything left unset
# falls back to the Delta default here.
# ---------------------------------------------------------------------------

# Site overrides: a local file, if present, is applied before the defaults.
_exp0_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$_exp0_env_dir/cluster.local.env" ] && . "$_exp0_env_dir/cluster.local.env"

# ---- Scheduler (Slurm) ----------------------------------------------------
# Accounts / partitions for GPU jobs (matrix, smoke, parity) and the CPU-only
# environment build.
: "${EXP0_GPU_ACCOUNT:=bcpt-delta-gpu}"
: "${EXP0_CPU_ACCOUNT:=bcpt-delta-cpu}"
: "${EXP0_GPU_PARTITION:=gpuA100x4}"
: "${EXP0_CPU_PARTITION:=cpu}"
: "${EXP0_CPUS_PER_TASK:=16}"
: "${EXP0_GPU_MEM:=200g}"
: "${EXP0_CPU_MEM:=48g}"
# GPUs per node available on EXP0_GPU_PARTITION -- submit_matrix.sh will not
# request more than this for any cell.
: "${EXP0_GPUS_PER_NODE_MAX:=4}"
# Anything extra every sbatch call should carry, e.g. "--qos=normal --constraint=x".
: "${EXP0_SBATCH_EXTRA:=}"

# ---- Software environment ------------------------------------------------
# EXP0_MODULES: arguments passed verbatim to a single `module load`, in order.
# Set to the empty string on clusters with no Lmod/tcl `module` (conda- or
# container-based) -- the scripts then just skip module handling.
: "${EXP0_MODULES:=python/3.13.5-gcc13.3.1 cudatoolkit/26.5_12.9-unsupported gcc-native/14 aws-ofi-nccl}"
# Modules to `module unload` first (Delta auto-loads a default cudatoolkit that
# collides with the cu128 one). Space-separated; empty to skip.
: "${EXP0_MODULE_UNLOAD:=cudatoolkit}"
# 1 => run `module purge` before anything else.
: "${EXP0_MODULE_PURGE:=0}"

# ---- Paths --------------------------------------------------------------
# REPO_ROOT and the inner monorepo are derived from each script's own location
# (see _lib.sh); override here only if your checkout layout differs.
: "${EXP0_REPO_ROOT:=}"                 # default: <this file>/../../..
: "${EXP0_VENV:=}"                      # default: <repo>/DistNNP/.venv-uma
: "${EXP0_UV:=uv}"                      # uv binary (env_setup.sh only)
# Writable scratch for the parity test's temp trajectory files.
: "${EXP0_SCRATCH:=${SCRATCH:-/tmp}}"

# ---- Runtime / NCCL ----------------------------------------------------
# High-speed fabric interface for NCCL. Delta = "hsn"; set to your cluster's
# (e.g. "ib0", "bond0") or the empty string to let NCCL auto-detect.
: "${EXP0_NCCL_SOCKET_IFNAME:=hsn}"
: "${EXP0_OMP_NUM_THREADS:=8}"
# uma-s-1p2 is pre-cached by env_setup.sh, so jobs run fully offline. Set to 0
# if your compute nodes have internet and you skipped the pre-warm.
: "${EXP0_HF_HUB_OFFLINE:=1}"
# Optional explicit HF / fairchem cache locations (else the user default).
: "${EXP0_HF_HOME:=}"

# ---- Extension build (env_setup.sh only) --------------------------------
# CUDA architectures to compile the 4 distnnp CUDA extensions for.
#   A100 = 80, H100/H200 = 90, A40 = 86, V100 = 70.
: "${EXP0_CUDA_ARCH:=80;90}"
: "${EXP0_TORCH_VERSION:=2.8.0}"
