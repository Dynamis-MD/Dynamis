# shellcheck shell=bash
# ---------------------------------------------------------------------------
# Example site override for running exp0 on a NON-Delta cluster.
#
#   cp scripts/cluster.env.example scripts/cluster.local.env
#   $EDITOR scripts/cluster.local.env
#
# cluster.local.env is git-ignored and sourced by scripts/cluster.env BEFORE
# its defaults, so anything you set here wins. You only need the lines that
# differ from the Delta defaults.
#
# The example below is a plausible config for a hypothetical H100 cluster whose
# GPU partition is called "gpu-h100" with 8 GPUs/node, an InfiniBand fabric,
# and an Lmod stack with different module names.
# ---------------------------------------------------------------------------

# --- Scheduler ---
export EXP0_GPU_ACCOUNT="myproject-gpu"
export EXP0_CPU_ACCOUNT="myproject-cpu"
export EXP0_GPU_PARTITION="gpu-h100"
export EXP0_CPU_PARTITION="cpu"
export EXP0_GPUS_PER_NODE_MAX=8
export EXP0_GPU_MEM="480g"
export EXP0_CPU_MEM="64g"
# export EXP0_SBATCH_EXTRA="--qos=normal"

# --- Software environment ---
# Match the CUDA toolkit to the torch build (cu128 -> CUDA 12.4+).
export EXP0_MODULES="python/3.13 cuda/12.4 gcc/13"
export EXP0_MODULE_UNLOAD=""
# export EXP0_MODULE_PURGE=1
#
# ...or, on a conda/container cluster with no `module` command, set:
# export EXP0_MODULES=""
# and make sure `python3` / the venv is already on PATH.

# --- Paths ---
# export EXP0_REPO_ROOT="/home/me/DistNNP"
# export EXP0_VENV="/home/me/DistNNP/DistNNP/.venv-uma"
# export EXP0_UV="$HOME/.local/bin/uv"

# --- Runtime / NCCL ---
export EXP0_NCCL_SOCKET_IFNAME="ib0"     # or "" to let NCCL auto-detect
# export EXP0_HF_HUB_OFFLINE=0            # if compute nodes have internet

# --- Datasets (scripts/setup_datasets.sh) ---
# export EXP0_DATA_TIERS="1 2 3 4"
# export EXP0_DATA_CH4_SIZES="1 2 32 64 128"
# export EXP0_DATA_SOLVATED="9gmo 2rik 1aki"
# export EXP0_DATA_ELECTROCHEM="12k 17k"
# Tier 3 archive: stage the 23 MB tar.xz once and point at it (compute nodes
# often have no outbound network). Or run `EXP0_DATA_TIERS="2 3" bash
# scripts/setup_datasets.sh` on a login node before submitting the rest.
# export DISTNNP_ARCHIVE_LOCAL="/scratch/$USER/distnnp_exp_datasets_v1.tar.xz"
# export DISTNNP_ARCHIVE_SHARED_DIR="/shared/datasets/distnnp"

# --- Extension build ---
export EXP0_CUDA_ARCH="90"                # H100/H200

# ===========================================================================
# Variant: GB200 NVL72 (Grace-Blackwell, aarch64, 72 NVLink-connected B200s)
# ===========================================================================
# export EXP0_GPU_ACCOUNT="myproj"
# export EXP0_CPU_ACCOUNT="myproj"
# export EXP0_GPU_PARTITION="gb200"
# export EXP0_CPU_PARTITION="grace"            # or the same partition, no --gres
# export EXP0_GPUS_PER_NODE_MAX=4              # B200s per Slurm node (NVL72 = 18 nodes)
# export EXP0_GPU_MEM="0"                      # "0" = all node memory
# export EXP0_MODULES="cuda/12.8 gcc/13"      # aarch64 toolchain; cu128+ required for Blackwell
# export EXP0_MODULE_UNLOAD=""
# export EXP0_NCCL_SOCKET_IFNAME=""            # NVLink/MNNVL: let NCCL auto-detect
# export EXP0_CUDA_ARCH="100"                  # B200 = sm_100 (compile the CUDA extensions for it)
# export EXP0_TORCH_VERSION="2.8.0"           # needs an aarch64 + cu128 wheel
# NOTE: env_setup.sh installs torch from https://download.pytorch.org/whl/cu128
#       -- that index serves aarch64 wheels for torch>=2.7. Verify `uv` + a
#       Python 3.12/3.13 are available on the Grace side.
# NOTE: a >4-GPU (multi-Slurm-node) run needs sbatch_exp0.sh's `--nodes=1` made
#       configurable -- see README "Multi-node".

# --- LAMMPS + MACE baseline (Workstream B) ---
# Only needed if you run the `lammps-mace` engine. It uses a SEPARATE python env
# and a from-source LAMMPS build (ML-IAP + KOKKOS + PYTHON); the stock LAMMPS
# modules on most clusters do not have these packages.
export EXP0_LAMMPS_ROOT="/scratch/$USER"                 # env + build tree live here (not $HOME)
export EXP0_LAMMPS_MODULES="cuda/12.6 gcc/13 cmake openmpi/5.0-cuda fftw"
export EXP0_LAMMPS_PYTHON="python3.12"
export EXP0_LAMMPS_TORCH="2.7.1"
export EXP0_LAMMPS_TORCH_INDEX="https://download.pytorch.org/whl/cu126"
export EXP0_MACE_MODEL_NAME="medium-mpa-0"
# export EXP0_MACE_MODEL="/path/to/mace-mpa-0-medium.model"   # else derived from ROOT
export EXP0_MACE_ELEMENTS="C H O"
